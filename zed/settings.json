// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ssh_connections": [
    {
      "host": "192.168.1.175",
      "projects": [{ "paths": ["~/homelab"] }],
      "port": 22, // defaults to 22
      "username": "pierre",
      "nickname": "magenta-zed"
    }
  ],
  "cli_default_open_behavior": "existing_window",

  // Keep git worktrees (Claude Code + Zed) out of the file finder,
  // project search and project panel of the main checkout.
  // NOTE: this REPLACES Zed's default list, so the defaults are repeated here.
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/.claude/worktrees",
    "**/.venv",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.ruff_cache"
  ],
  "git": {
    // Where Zed's worktree picker (cmd-ctrl-w) creates and looks for
    // worktrees — same place Claude Code puts its own.
    "worktree_directory": ".claude/worktrees"
  },
  "git_panel": {
    "tree_view": true
  },
  "collaboration_panel": {
    "button": false
  },
  "agent": {
    "single_file_review": true,
    "favorite_models": [],
    "model_parameters": [],
    "expand_terminal_card": false
  },
  "vim": {
    "use_system_clipboard": "never"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "agent_servers": {
    "claude-acp": {
      "favorite_config_option_values": {
        "model": [
          "opus[1m]"
        ]
      },
      "default_config_options": {
        "fast": false,
        "effort": "high",
        "mode": "auto",
        "model": "opus[1m]"
      },
      "type": "registry"
    }
  },
  "base_keymap": "Zed",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
}
